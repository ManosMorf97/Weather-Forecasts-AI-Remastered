@startuml UC1_Login_Activity_Diagram

title UC1: Login - Activity Diagram

start
:User navigates to login page;
repeat
  :System displays login form;

  if (User selects "Forgot Password"?) then (yes)
    :System initiates password recovery process;
    note right: Alternative Flow A2 - Forgot Password
    stop
  endif

  :User enters credentials;

  if (Authentication service available?) then (no)
    :System displays maintenance message;
    note right: Exception E1 - Authentication service unavailable
    stop
  endif

  :System validates credentials;
  if (Credentials valid?) then (yes)
    :System creates user session;
    :System redirects user to dashboard;
    stop
  else (no)
    :System displays error message;
  endif
repeat while (Retry?) is (yes) not (no)

@enduml
