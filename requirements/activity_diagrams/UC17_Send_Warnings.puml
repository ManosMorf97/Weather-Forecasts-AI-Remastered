@startuml UC17_Send_Warnings_Activity_Diagram

title UC17: Send Warnings - Activity Diagram

start
:Scheduler triggers warning detection job;
:System analyzes stored forecasts for hazardous conditions;
:System identifies cities with life-threatening weather;

if (Hazards detected?) then (yes)
  :System queries users subscribed to affected cities;
  
  repeat
    :Select next affected user;
    
    if (Warning already sent for same condition?) then (no)
      :System invokes UC14 (Receive Warning Notification);
      :System logs warning event;
      :System tracks notification delivery status;
    else (yes)
      :System skips duplicate notification;
    endif
    
  repeat while (More affected users?) is (yes)
  ->no;
  
else (no hazards)
  :System completes normally;
endif

stop

@enduml
