@startuml UC3_Edit_Profile_Activity_Diagram

title UC3: Edit Profile - Activity Diagram

start
:User selects "Edit Profile" option;
repeat
  :System retrieves and displays current profile data;
  :User modifies profile fields;

  if (User wants to modify cities?) then (yes)
    partition "Select Cities (UC4)" {
      :User searches/modifies cities;
      :User adds or removes cities;
    }
  endif

  if (User wants to modify services?) then (yes)
    partition "Select Forecasting Services (UC5)" {
      :User modifies selected services;
    }
  endif

  :User submits changes;

  if (Any changes detected?) then (no)
    :System displays "no changes made" message;
    stop
  endif

  :System validates input and checks that
  updated email and username are not already
  used by another account;

  if (Validation successful and no conflicts?) then (yes)
    if (Concurrent update conflict detected?) then (yes)
      :System displays concurrent update error;
      :System reloads current profile data;
    else (no)
      if (Password was changed?) then (yes)
        :System hashes the new password;
      endif
      :System updates profile record;
      :System displays confirmation message;
      stop
    endif
  else (validation failed or conflict)
    :System displays conflict/validation error;
  endif
repeat while (Retry?) is (yes) not (no)

@enduml
