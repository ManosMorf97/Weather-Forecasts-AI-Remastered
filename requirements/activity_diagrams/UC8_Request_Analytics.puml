@startuml UC8_Request_Analytics_Activity_Diagram

title UC8: Request Analytics - Activity Diagram

|End User / Frontend|
start
:User selects "Request Analytics";
:System displays analytics request form;
:User specifies parameters (cities, services, date range);
note right
  Cities and services must each be a
  subset of the user's own selections.
  Metrics are fixed: temperature,
  humidity, wind speed (avg, SD, min,
  max) + danger-day count + sample count.
end note
:User submits request (POST /api/analytics, Bearer JWT);

|User Actions Server (synchronous)|
:Verify JWT with Authentication Service;
if (JWT valid?) then (no)
  :Return 401 Unauthorized;
  stop
else (yes)
endif

:Validate parameters;
if (Cities and services non-empty, valid date range within 366 days?) then (no)
  :Return 400 (invalid date range / invalid cities / invalid services);
  note right: A1
  stop
else (yes)
endif

:Load the user's selected cities and services;
if (Every requested city and service is in the user's selection?) then (no)
  :Return 400 (InvalidCities / InvalidServices);
  note right: A2
  stop
else (yes)
endif

:Create an AnalyticsReportBatch with one Queued AnalyticsReport per service, each with a CityMetric row per city;
if (Saved?) then (no)
  :Return 500 (failed to queue);
  note right: E2
  stop
else (yes)
endif
:Return 202 Accepted with batch_id;
detach

|Analytics Report Worker (asynchronous, ~5s poll)|
start
repeat
  :Poll DB for Queued reports;
  repeat
    :Read forecast samples for the report's service, cities and date range;
    if (Samples loaded?) then (yes)
      :Compute per-city statistics (avg / SD / min / max, danger days);
      :Save results, status = Completed;
    else (no)
      :Save status = Failed;
      note right: A3
    endif
  repeat while (More Queued reports?) is (yes) not (no)

  :Find batches whose reports have all finished but are not yet delivered;
  repeat
    :Fetch user's email from Authentication Service;
    if (Email lookup ok?) then (no)
      :Leave batch undelivered, retry next cycle;
      note right: E3
    else (yes)
      if (Any Completed reports?) then (no)
        :Send "report could not be generated" email;
        note right: A4
      else (yes)
        :Render PDF (bar charts + tables);
        if (PDF rendered?) then (no)
          :Send text-only email with the numbers;
          note right: A5
        else (yes)
          :Send email with PDF attached;
        endif
      endif
      if (Email sent?) then (yes)
        :Mark batch delivered;
      else (no)
        :Leave batch undelivered, retry next cycle;
        note right: E3
      endif
    endif
  repeat while (More undelivered batches?) is (yes) not (no)
repeat while (Worker running?) is (yes) not (no)
stop

@enduml
