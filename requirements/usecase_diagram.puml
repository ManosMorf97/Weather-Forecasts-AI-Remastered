@startuml Weather_Forecasts_UseCase_Diagram

title Weather Forecasts System - Use Case Diagram

' Actors
actor "End User" as User
actor "Scheduler" as Scheduler

' System boundary
rectangle "Weather Forecasts System" {
    
    ' User Management
    usecase "Login" as UC1
    usecase "Create Profile" as UC2
    usecase "Edit Profile" as UC3
    
    ' Service and City Selection
    usecase "Select Cities" as UC4
    usecase "Select Forecasting\nServices" as UC5
    
    ' Forecast Operations
    usecase "Search Forecast\nby City" as UC6
    usecase "Rate Forecasting\nService" as UC7
    
    ' Analytics
    usecase "Request Analytics" as UC8
    usecase "Download Analytics" as UC9
    usecase "View Aggregated\nForecast" as UC10
    
    ' System Operations (Scheduler)
    usecase "Poll Forecasts and\nNotify Users" as UC11

    ' Calculation (invoked by UC8 and UC10)
    usecase "Calculate Aggregates" as UC12
}

' End User relationships
User --> UC1
User --> UC2
User --> UC3
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10

' Scheduler relationships
Scheduler --> UC11

' Use case dependencies
UC2 ..> UC4 : <<include>>
UC2 ..> UC5 : <<include>>
UC4 ..> UC3 : <<extend>>
UC5 ..> UC3 : <<extend>>

UC7 ..> UC6 : <<extend>>
UC8 ..> UC12 : <<include>>
UC9 ..> UC8 : <<precondition>>
UC10 ..> UC12 : <<include>>

' Notes
note right of UC7
  User rates specific forecast
  instances: (city, service,
  timestamp) combinations.
  Service averages calculated
  from all its forecast ratings
end note

note right of UC11
  Polls partner APIs for (city, service)
  combinations selected by users, stores
  new/changed forecasts, and notifies
  users of danger forecasts they have not
  yet been notified about (new subscribers
  to an existing danger are still notified;
  already-notified users are not repeated
  unless the forecast data changes)
end note

note right of UC12
  Invoked by UC8 and UC10.
  Uses aggregated service ratings
  from UC7 to select best-rated
  service per city
end note

@enduml
