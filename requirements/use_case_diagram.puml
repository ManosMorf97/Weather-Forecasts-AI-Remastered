@startuml Weather_Forecasts_Use_Case_Diagram
!theme plain
left to right direction
skinparam packageStyle rect

' Actors
actor "End User" as User
actor "Forecast Service\n(Partner)" as Partner
actor "System Scheduler" as Scheduler
actor "Administrator" as Admin

' System Boundary
rectangle "Weather Forecasts System" {
  
  ' User Management
  package "User Management" {
    usecase "Register/Login" as UC1
    usecase "Create/Edit Profile" as UC2
    usecase "Select Services" as UC2a
    usecase "Set Areas of Interest" as UC2b
  }
  
  ' Forecast Access
  package "Forecast Access" {
    usecase "Search Forecast\nby Area" as UC3
    usecase "View Current\nWeather" as UC4
    usecase "View Hourly\nForecast (3h)" as UC5
    usecase "View Daily\nForecast (3 days)" as UC6
  }
  
  ' Rating & Analytics
  package "Rating & Analytics" {
    usecase "Rate Forecast\n(1-5 scale)" as UC7
    usecase "Download Analytics" as UC8
    usecase "View Aggregated\nForecasts" as UC8a
    usecase "Compare Multiple\nServices" as UC8b
  }
  
  ' Alerts
  package "Alerts & Warnings" {
    usecase "Receive Warning\nNotifications" as UC9
    usecase "Subscribe to\nArea Alerts" as UC9a
  }
  
  ' Data Ingestion
  package "Data Ingestion" {
    usecase "Push Forecast\nUpdate" as UC10
    usecase "Scheduled Polling\nand Storage" as UC11
    usecase "Store Forecast Data" as UC11a
    usecase "Validate Forecast\nData" as UC11b
  }
  
  ' Administration
  package "System Administration" {
    usecase "Manage Partner\nIntegrations" as UC12
    usecase "Configure System" as UC13
  }
}

' User Relationships
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9

' Partner Relationships
Partner --> UC10

' Scheduler Relationships
Scheduler --> UC11

' Administrator Relationships
Admin --> UC12
Admin --> UC13

' Include Relationships
UC2 .> UC2a : <<include>>
UC2 .> UC2b : <<include>>
UC2 ..> UC1 : <<require>>
UC3 ..> UC1 : <<require>>
UC7 ..> UC1 : <<require>>
UC8 ..> UC1 : <<require>>
UC8 .> UC8a : <<include>>
UC8 .> UC8b : <<include>>
UC9 .> UC9a : <<include>>
UC10 .> UC11a : <<include>>
UC10 .> UC11b : <<include>>
UC11 .> UC11a : <<include>>
UC11 .> UC11b : <<include>>

' Extend Relationships
UC4 ..> UC3 : <<extend>>
UC5 ..> UC3 : <<extend>>
UC6 ..> UC3 : <<extend>>
UC7 ..> UC3 : <<extend>>

' Data Dependencies
UC8 ..> UC7 : uses ratings
UC3 ..> UC11a : reads from
UC9 ..> UC11a : reads from

' Notes
note right of UC7
  Ratings stored per
  service and region
end note

note right of UC8
  Weighted aggregates based
  on service ratings
end note

note bottom of UC10
  Auth: API key or
  signed request
end note

note right of UC9
  Life-threatening
  weather alerts only
end note

@enduml
