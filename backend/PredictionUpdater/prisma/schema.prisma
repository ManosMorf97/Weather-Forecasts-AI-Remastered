// These models mirror the tables owned by the WeatherUserActions .NET service (EF Core
// migrations). PredictionUpdater NEVER migrates this database - it only reads and writes rows.
//
// Regenerate against the real database with:  npm run db:pull
// `prisma db pull` keeps the @map / @@map / relation names below on re-introspection, and will
// also pull in the tables this job does not use (Ratings, Analytics*). Leave those in.
//
// If the .NET schema changes (a migration touches Forecasts / Notifications / CitySites / ...),
// re-run `npm run db:pull` and the test suite before deploying.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  // Prisma 7 no longer reads connection URLs from schema files. Configure the database URL in
  // `prisma.config.ts` for the CLI, and pass `datasourceUrl` / the appropriate driver config to
  // `new PrismaClient(...)` at runtime.
}

model User {
  userId    String   @id @map("UserId") @db.NVarChar(128)
  createdAt DateTime @map("CreatedAt") @db.DateTime2

  userCitySites UserCitySite[]
  userServices  UserService[]
  notifications Notification[]

  @@map("Users")
}

model City {
  cityId    Int     @id @default(autoincrement()) @map("CityId")
  name      String  @map("Name") @db.NVarChar(200)
  country   String  @map("Country") @db.NVarChar(200)
  latitude  Decimal @map("Latitude") @db.Decimal(11, 8)
  longitude Decimal @map("Longitude") @db.Decimal(11, 8)

  citySites CitySite[]

  @@unique([name, country, latitude, longitude], map: "IX_Cities_Name_Country_Latitude_Longitude")
  @@map("Cities")
}

model ForecastingService {
  serviceId   Int    @id @default(autoincrement()) @map("ServiceId")
  name        String @map("Name") @db.NVarChar(Max)
  apiEndpoint String @map("ApiEndpoint") @db.NVarChar(Max)

  citySites    CitySite[]
  userServices UserService[]

  @@map("ForecastingServices")
}

model CitySite {
  citySiteId Int @id @default(autoincrement()) @map("CitySiteId")
  cityId     Int @map("CityId")
  serviceId  Int @map("ServiceId")

  city    City               @relation(fields: [cityId], references: [cityId], onDelete: NoAction, onUpdate: NoAction)
  service ForecastingService @relation(fields: [serviceId], references: [serviceId], onDelete: NoAction, onUpdate: NoAction)

  userCitySites UserCitySite[]
  forecasts     Forecast[]

  @@unique([cityId, serviceId], map: "IX_CitySites_CityId_ServiceId")
  @@map("CitySites")
}

model UserCitySite {
  userId     String   @map("UserId") @db.NVarChar(128)
  citySiteId Int      @map("CitySiteId")
  addedAt    DateTime @map("AddedAt") @db.DateTime2

  user     User     @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  citySite CitySite @relation(fields: [citySiteId], references: [citySiteId], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, citySiteId])
  @@map("UserCitySites")
}

model UserService {
  userId    String   @map("UserId") @db.NVarChar(128)
  serviceId Int      @map("ServiceId")
  addedAt   DateTime @map("AddedAt") @db.DateTime2

  user    User               @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  service ForecastingService @relation(fields: [serviceId], references: [serviceId], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, serviceId])
  @@map("UserServices")
}

model Forecast {
  forecastId    Int      @id @default(autoincrement()) @map("ForecastId")
  citySiteId    Int      @map("CitySiteId")
  timestamp     DateTime @map("Timestamp") @db.DateTime2
  type          String   @map("Type") @db.NVarChar(450)
  temperature   Decimal  @map("Temperature") @db.Decimal(3, 1)
  humidity      Decimal  @map("Humidity") @db.Decimal(5, 2)
  windSpeed     Decimal  @map("WindSpeed") @db.Decimal(5, 2)
  dangerFlag    Boolean  @map("DangerFlag")
  // Minutes east of UTC for `timestamp`'s location at that instant (e.g. Athens summer = 180).
  // Snapshotted per row, not looked up from City, because DST shifts it across the forecast
  // window - lets the frontend render local wall-clock without its own timezone database.
  offsetMinutes Int      @map("OffsetMinutes")
  retrievedAt   DateTime @map("RetrievedAt") @db.DateTime2

  citySite      CitySite       @relation(fields: [citySiteId], references: [citySiteId], onDelete: NoAction, onUpdate: NoAction)
  notifications Notification[]

  @@unique([citySiteId, timestamp, type], map: "IX_Forecasts_CitySiteId_Timestamp_Type")
  @@map("Forecasts")
}

model Notification {
  notificationId Int      @id @default(autoincrement()) @map("NotificationId")
  userId         String   @map("UserId") @db.NVarChar(128)
  forecastId     Int      @map("ForecastId")
  channel        String   @map("Channel") @db.NVarChar(Max)
  status         String   @map("Status") @db.NVarChar(Max)
  sentAt         DateTime @map("SentAt") @db.DateTime2

  user     User     @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  forecast Forecast @relation(fields: [forecastId], references: [forecastId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Notifications")
}
