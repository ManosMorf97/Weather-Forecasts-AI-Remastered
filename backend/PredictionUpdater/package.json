{
  "name": "prediction-updater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UC11 scheduler: polls partner weather services, stores forecasts, notifies users of danger. Separate process from WeatherUserActions; shares only the database.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:pull": "prisma db pull && prisma generate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "node-appwrite": "^14.1.0",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/mssqlserver": "^10.16.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
