# Copy to .env and fill in. .env is git-ignored. Values already present in the real
# environment win over anything set here (dotenv does not override).

# --- Database ---
# The connection is assembled from these three machine environment variables - the SAME ones
# WeatherUserActions' Program.cs reads. Set them in your environment, NOT here:
#   YOUR_DATABASE_SERVER    host, "host,port", or "host\INSTANCE"
#   YOUR_USER      SQL login
#   YOUR_PASSWORD  SQL password
# Database name defaults to weather_forecasts_ai; override with DB_NAME if needed.
#DB_NAME=weather_forecasts_ai

# --- Weather provider API keys (this service's own - keep them here) ---
# Open-Meteo needs no key. A provider whose key is missing is skipped (logged).
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=
VISUALCROSSING_API_KEY=

# CAP alert severities (from WeatherAPI.com / Visual Crossing) that count as danger-to-life.
DANGER_CAP_SEVERITIES=Extreme,Severe

# --- Appwrite (for the danger-notification email lookup) ---
# YOUR_APPWRITE_* are machine environment variables shared with WeatherUserActions - set them
# in your environment, not here.
APPWRITE_ID_CHUNK_SIZE=100

# --- Email (danger notifications). No SMTP_HOST => messages are logged, not sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Weather Alerts <noreply@weatherforecasts.local>"

# --- Misc ---
HTTP_TIMEOUT_MS=15000
LOG_LEVEL=info
